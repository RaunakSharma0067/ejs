<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <center>
        <h1>Student DashBoard</h1>
        <% if(msg){ %>

            <p style="color:green;">
                <%= msg %>
            </p>

            <% } %>

                <table border="1" width="500" align="center">
                    <thead>
                        <tr align="right">
                            <th colspan="5"><a href="/add-student/">Add Student</a></th>
                        </tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Course</th>
                        <th>Action</th>
                    </thead>
                </table>

                <table border="1" width="500" align="center">

                    <tbody>
                        <% studentDetails.forEach(stu=>{%>
                            <tr>
                                <td>
                                    <%=stu.name%>
                                </td>
                                <td>
                                    <%=stu.email%>
                                </td>
                                <td>
                                    <%=stu.phone%>
                                </td>
                                <td>
                                    <%=stu.course%>
                                </td>
                                <td><a href="/show-details/<%=stu._id%>">Show</a>||
                                    <a href="/edit-student/<%=stu._id%>">Edit</a>||
                                    <a href="/delete-student/<%=stu._id%>"
                                        onclick="javascript:return confirm('Are You Sure Want To Delete This Record?')">Delete</a>
                                </td>
                            </tr>
                            <%})%>
                    </tbody>
                </table>
    </center>

</body>

</html>