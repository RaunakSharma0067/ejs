<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error 404 Page Not Found</title>
</head>

<body>
        <h1 style="color:#8fc630">Error 404 </h1> <br>
        <h2 style="color:red">The Requested Page Is Unavailable.</h2>
    
    <% if(message){ %>
    <p><%= message %></p>
<% } else { %>
    <h2 style="color:red">The Requested Page Is Unavailable.</h2>
<% } %>
</body>

</html>