<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show details</title>
</head>
<body>
    <center>
        <h2>Student Details</h2>
        <form method="post">
            <table border="1" width="30">
                <tr><th>Name</th><td><%=stu.name%></td></tr>
                <tr><th>Email</th><td><%=stu.email%></td></tr>
                <tr><th>Phone</th><td><%=stu.phone%></td></tr>
                <tr><th>Course</th><td><%=stu.course%></td></tr>
            <tr align="center"><td colspan="2">
                <a href="/edit-student/<%=stu._id%>">Edit</a>||
                <a href="/delete-student/<%=stu._id%>" onclick="javascript:return confirm('Are You Sure Want To Delete This Record')">Delete</a>

                <a href="javascript:window.print()">Print</a> ||
                <a href="/">Cancel</a>  
            </td></tr>
            </table>
        </form>
    </center>
</body>
</html>